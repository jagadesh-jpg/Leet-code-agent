# Dockerfile for Hardened Multi-Language Code Execution Sandbox
# Tag convention: agent-sandbox:v1
# Base: Ubuntu 24.04 LTS (Noble)
FROM ubuntu:24.04

# Prevent interactive prompts during installation
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Install full toolchains:
# - build-essential provides gcc, g++, make, libc6-dev, binutils (ld, as, ar)
# - python3 and python3-minimal for Python executions
# - default-jdk-headless for Java compile (javac) and execution (java)
# - coreutils for standard CLI execution tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    python3-minimal \
    default-jdk-headless \
    coreutils \
    && rm -rf /var/lib/apt/lists/*

# Create dedicated non-root unprivileged sandbox user (UID:GID 1000:1000).
# Ubuntu 24.04 (Noble) base image includes a default 'ubuntu' user/group with UID:GID 1000:1000.
# Safely remove any preexisting account occupying UID/GID 1000, verify vacancy, then provision 'sandbox:sandbox'.
# Build-time assertions verify username, UID, GID, home directory, and non-root identity.
RUN set -e; \
    if id -u 1000 >/dev/null 2>&1; then \
        PREV_USER="$(id -un 1000)"; \
        userdel -r "$PREV_USER" || { \
            echo "Error: Failed to safely remove preexisting user '$PREV_USER' (UID 1000)"; \
            exit 1; \
        }; \
    fi; \
    if getent group 1000 >/dev/null 2>&1; then \
        PREV_GROUP="$(getent group 1000 | cut -d: -f1)"; \
        groupdel "$PREV_GROUP" || { \
            echo "Error: Failed to safely remove preexisting group '$PREV_GROUP' (GID 1000)"; \
            exit 1; \
        }; \
    fi; \
    ! id -u 1000 >/dev/null 2>&1 || { echo "Error: UID 1000 still occupied before creation"; exit 1; }; \
    ! getent group 1000 >/dev/null 2>&1 || { echo "Error: GID 1000 still occupied before creation"; exit 1; }; \
    groupadd -g 1000 sandbox && \
    useradd -u 1000 -g 1000 -m -d /home/sandbox -s /bin/bash -c "Sandbox User" sandbox && \
    [ "$(id -u sandbox)" = "1000" ] && \
    [ "$(id -g sandbox)" = "1000" ] && \
    [ "$(id -un sandbox)" = "sandbox" ] && \
    [ "$(id -gn sandbox)" = "sandbox" ] && \
    [ "$(id -u sandbox)" != "0" ] && \
    [ -d "/home/sandbox" ] && \
    id sandbox

# Create dedicated sandbox workspace and temp directory with strict permissions
RUN mkdir -p /workspace /tmp && \
    chown -R sandbox:sandbox /workspace /tmp && \
    chmod 777 /tmp

# Default working directory
WORKDIR /workspace

# Default unprivileged user
USER 1000:1000

# Default command
CMD ["/bin/bash"]
