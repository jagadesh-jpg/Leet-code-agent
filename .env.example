# LLM Configuration
# Provide your provider's model ID and API key.
# For Google Gemini OpenAI-compatible endpoint:
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=

# Alternative OpenAI-compatible base URLs:
# Groq: https://api.groq.com/openai/v1
# Ollama: http://localhost:11434/v1

# Optional secondary backup LLM (automatically falls back if primary returns 429/503)
LLM2_BASE_URL=
LLM2_API_KEY=
LLM2_MODEL=

LLM_DELAY_SECONDS=4
JUDGE_TIMEOUT_SECONDS=10
